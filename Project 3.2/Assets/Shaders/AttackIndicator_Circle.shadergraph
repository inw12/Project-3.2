    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "7af80d6b522e4c34a08c99dba80917c8",
    "m_Title": "Shift Origin to center of Quad",
    "m_Content": "Before SUBTRACT:\n- (0, 0) = Bottom Left\n- (0.5, 0.5) = Center\n- (1, 1) = Top Right\n\nAfter SUBTRACT:\n- (-0.5, -0.5) = Bottom Left\n- (0, 0) = Center\n- (0.5, 0.5) = Top Right\n",
    "m_TextSize": 0,
    "m_Theme": 1,
    "m_Position": {
